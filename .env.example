# Copiá este archivo a .env y ajustá los valores. Nunca subas .env al repositorio.
# Todos los valores de ejemplo son seguros para desarrollo local; cambiá las contraseñas en producción.

# --- Entorno ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- Base de datos (docker compose usa estas variables para crear la base) ---
POSTGRES_USER=wfa
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=wfa
POSTGRES_PORT=5432
# Para correr la API fuera de Docker:
DATABASE_URL=postgresql+psycopg://wfa:cambiar-en-produccion@localhost:5432/wfa
# También se acepta postgres:// o postgresql:// (formato de Neon y Render).
DB_POOL_SIZE=10

# --- Almacenamiento de logs subidos ---
STORAGE_DIR=./storage

# --- Seguridad ---
COOKIE_SECURE=false            # true detrás de HTTPS (obligatorio en producción)
COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
TRUSTED_PROXIES=               # IPs o rangos CIDR de proxies cuyo X-Forwarded-For se acepta (ej. 172.16.0.0/12)
PROXY_SHARED_SECRET=           # mismo valor en la API y en la web (Vercel) para recibir la IP real del visitante
CORS_ORIGINS=                  # vacío: el frontend usa el proxy de Next.js (mismo origen)
PUBLIC_UPLOADS=false           # true permite importar sin cuenta (no recomendado)

# --- Límites del importador ---
MAX_UPLOAD_MB=200
MAX_UNCOMPRESSED_MB=600
MAX_COMPRESSION_RATIO=40

# --- Rate limiting (por IP y proceso) ---
RATE_LIMIT_PUBLIC_PER_MIN=240
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_IMPORT_PER_HOUR=20

# --- Worker ---
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=4
JOB_BACKOFF_BASE_SECONDS=15
JOB_STALE_MINUTES=30
INLINE_WORKER=false            # true: procesa la cola dentro de la API (despliegue de un solo contenedor)
SEED_DEMO=false                # true: scripts/start.sh carga los datos DEMO al arrancar si no existen
SEED_DEMO_WEEKS=4

# --- Rankings ---
MIN_BUCKET_SIZE=10
CONSISTENCY_MIN_KILLS=3
CONSISTENCY_LAST_N=10
STALE_AFTER_HOURS=72
RANKING_CACHE_SECONDS=120

# --- Primer admin (sólo para `python -m app.cli create-admin --from-env`; borrá los valores después) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- API de Blizzard (desactivada: no hay namespace verificado para Forever) ---
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_FOREVER_NAMESPACE=

# --- Frontend ---
API_INTERNAL_URL=http://localhost:8000   # URL de la API vista desde el servidor de Next.js
API_PORT=8000
WEB_PORT=3000
